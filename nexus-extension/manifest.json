{
  "manifest_version": 3,
  "name": "Timecard \u2192 Nexus",
  "version": "1.13",
  "description": "Fills the Nexus hours form from a Timecard rocket press, and looks up a task's project and contractor. Never presses Submit.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "*://nexus.tcs.local/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://nexus.tcs.local/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "*://nexus.tcs.local/*"
      ]
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ]
}
