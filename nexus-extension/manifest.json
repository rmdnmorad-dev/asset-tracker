{
  "manifest_version": 3,
  "name": "Timecard → Nexus",
  "version": "1.0",
  "description": "Fills the Nexus hours form from a Timecard rocket press. Never presses Submit.",
  "content_scripts": [
    {
      "matches": ["*://nexus.tcs.local/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["*://nexus.tcs.local/*"]
    }
  ]
}
